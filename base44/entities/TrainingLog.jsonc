{
  "name": "TrainingLog",
  "type": "object",
  "properties": {
    "athlete_email": {
      "type": "string",
      "description": "Email of the athlete"
    },
    "event_category": {
      "type": "string",
      "enum": [
        "throwing",
        "jumping",
        "running"
      ],
      "description": "Category of the event"
    },
    "event": {
      "type": "string",
      "enum": [
        "shot_put",
        "discus",
        "javelin",
        "long_jump",
        "triple_jump",
        "high_jump",
        "pole_vault",
        "100m",
        "200m",
        "400m",
        "800m",
        "1600m",
        "3200m",
        "100m_hurdles",
        "110m_hurdles",
        "300m_hurdles",
        "4x100_relay",
        "4x400_relay",
        "4x800_relay"
      ],
      "description": "Type of event"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the training"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "practice",
        "meet"
      ],
      "default": "practice",
      "description": "Type of session"
    },
    "time": {
      "type": "string",
      "description": "Time or split (e.g., 2:45 or 165 seconds)"
    },
    "notes": {
      "type": "string",
      "description": "Notes about the training session"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the uploaded video for this session"
    }
  },
  "required": [
    "athlete_email",
    "event",
    "date",
    "time"
  ]
}