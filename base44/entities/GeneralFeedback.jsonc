{
  "name": "GeneralFeedback",
  "type": "object",
  "properties": {
    "athlete_email": {
      "type": "string",
      "description": "Email of the athlete receiving feedback"
    },
    "coach_email": {
      "type": "string",
      "description": "Email of the coach providing feedback"
    },
    "feedback_content": {
      "type": "string",
      "description": "The main feedback message for the athlete"
    },
    "event": {
      "type": "string",
      "enum": [
        "shot_put",
        "discus",
        "javelin",
        "long_jump",
        "triple_jump",
        "high_jump",
        "pole_vault",
        "100m",
        "200m",
        "400m",
        "800m",
        "1600m",
        "3200m",
        "100m_hurdles",
        "110m_hurdles",
        "300m_hurdles",
        "4x100_relay",
        "4x400_relay",
        "4x800_relay"
      ],
      "description": "Specific event this feedback relates to (optional)"
    },
    "ai_conversation": {
      "type": "string",
      "description": "JSON string of AI dialogue history used to draft this feedback"
    }
  },
  "required": [
    "athlete_email",
    "coach_email",
    "feedback_content"
  ]
}